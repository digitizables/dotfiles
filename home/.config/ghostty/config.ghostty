# Every Ghostty window attaches to one Zellij session named main.
# Closing the window leaves that session running. The next window
# comes back to the same panes. direct: runs Zellij with no extra shell.
# Zellij then opens Zsh. See ~/.config/zellij/config.kdl.
command = direct:/usr/bin/zellij attach -c main

# Black window. The 16 ANSI colors stay the GNOME palette so green, blue,
# and the other highlights match a normal terminal. Bold text uses the
# bright row, which is what makes directories and the prompt stand out.
background = #000000
foreground = #ffffff
bold-color = bright
palette = 0=#171421
palette = 1=#c01c28
palette = 2=#26a269
palette = 3=#a2734c
palette = 4=#12488b
palette = 5=#a347ba
palette = 6=#2aa1b3
palette = 7=#d0cfcc
palette = 8=#5e5c64
palette = 9=#f66151
palette = 10=#33d17a
palette = 11=#e9ad0c
palette = 12=#2a7bde
palette = 13=#c061cb
palette = 14=#33c7de
palette = 15=#ffffff
